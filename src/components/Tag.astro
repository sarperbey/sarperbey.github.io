---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";
import { categoryColor, categoryLabel } from "@/utils/categories";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `categories/${tag}/`)}
    style={`color: ${categoryColor(tag)}`}
    class:list={[
      "flex items-center gap-0.5",
      "border-b-2 border-dashed border-current",
      "hover:-mt-0.5",
      "focus-visible:text-accent focus-visible:border-none",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {categoryLabel(tag)}
  </a>
</li>
