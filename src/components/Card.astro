---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { categoryColor, categoryLabel } from "@/utils/categories";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, link, lang, ...props } = data;
const host = link ? new URL(link).hostname.replace(/^www\./, "") : null;
const category = slugifyStr(data.tags[0] ?? "others");
---

<li class="link-card">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="u-sweep link-card-main inline-block"
  >
    <Heading class="font-display text-[1.75rem] leading-tight sm:text-3xl break-words">
      {title}
    </Heading>
  </a>
  {description && <p class="link-card-note">{description}</p>}
  <div class="link-card-meta">
    {host && (
      <a href={link} rel="noopener noreferrer" class="link-card-host">
        {host}
      </a>
    )}
    <Datetime {...props} variant="inline" />
    <span style={`color: ${categoryColor(category)}`}>
      {categoryLabel(category)}
    </span>
    {lang !== "en" && <span class="uppercase">{lang}</span>}
  </div>
</li>
