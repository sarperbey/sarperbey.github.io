---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { slugifyStr } from "@/utils/slugify";
import { categoryColor, categoryLabel } from "@/utils/categories";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, link, lang, ...props } = data;
const host = link ? new URL(link).hostname.replace(/^www\./, "") : null;
const category = slugifyStr(data.tags[0] ?? "others");
---

<li class="link-card">
  <div
    class="text-xs font-medium tracking-wider uppercase"
    style={`color: ${categoryColor(category)}`}
  >
    {categoryLabel(category)} · {lang}
  </div>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="u-sweep inline-block"
  >
    <Heading
      class="font-display mt-1 text-2xl leading-tight"
      transition:name={toTransitionName(id)}
    >
      {title}
    </Heading>
  </a>
  <Datetime {...props} />
  <p class="text-muted-foreground">{description}</p>
  {
    link && (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent mt-1 inline-block text-sm underline decoration-dashed underline-offset-4"
      >
        {host} ↗
      </a>
    )
  }
</li>
