---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyAll } from "@/utils/slugify";
import { CATEGORIES, categoryColor, categoryLabel } from "@/utils/categories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const used = getUniqueTags(posts).map(({ tag }) => tag);
const known = CATEGORIES.map(c => c.slug as string);
// Fixed categories first (in order), then any other tags that exist
const slugs = [
  ...known.filter(s => used.includes(s)),
  ...used.filter(s => !known.includes(s)),
];
const count = (slug: string) =>
  posts.filter(({ data }) => slugifyAll(data.tags).includes(slug)).length;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul class="grid gap-x-10 sm:grid-cols-2">
      {
        slugs.map(slug => (
          <li class="border-border border-t">
            <a
              href={getRelativeLocaleUrl(locale, `categories/${slug}/`)}
              class="group flex items-baseline justify-between gap-4 py-4"
            >
              <span class="flex items-center gap-3">
                <span
                  aria-hidden="true"
                  class="size-3 shrink-0 rounded-full"
                  style={`background: ${categoryColor(slug)}`}
                />
                <span class="font-display u-sweep text-2xl">
                  {categoryLabel(slug)}
                </span>
              </span>
              <span class="text-muted-foreground text-sm">{count(slug)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
