---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyStr } from "@/utils/slugify";
import { CATEGORIES, categoryColor, categoryLabel } from "@/utils/categories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const banner = sortedPosts.find(({ data }) => data.featured) ?? sortedPosts[0];
const listPosts = sortedPosts
  .filter(post => post.id !== banner?.id)
  .slice(0, postsConfig.perIndex);
const usedTags = new Set(getUniqueTags(posts).map(({ tag }) => tag));
const topics = CATEGORIES.filter(({ slug }) => usedTags.has(slug));
const bannerCategory = banner
  ? slugifyStr(banner.data.tags[0] ?? "others")
  : "";
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1
        class="hero-title my-4 inline-block text-5xl leading-tight sm:my-8 sm:text-6xl"
      >
        Read slowly. <span class="text-accent">Three languages.</span>
      </h1>{" "}
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="text-muted-foreground max-w-xl text-lg">
        Links I saved with a short note, plus longer posts and images.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      banner && (
        <section id="featured" class="pt-10 pb-2">
          <a
            href={getPostUrl(banner.id, banner.filePath, Astro.currentLocale)}
            class="feature-banner"
          >
            <div class="text-xs font-medium tracking-widest uppercase">
              {banner.data.featured ? `${t.home.featured} · ` : ""}
              {categoryLabel(bannerCategory)} · {banner.data.lang}
            </div>
            <h2 class="font-display my-3 text-4xl leading-tight sm:text-5xl">
              {banner.data.title}
            </h2>
            <p class="max-w-xl text-lg">{banner.data.description}</p>
          </a>
        </section>
      )
    }

    {
      topics.length > 0 && (
        <nav
          aria-label="Topics"
          class="flex flex-wrap gap-x-6 gap-y-2 pt-8 pb-2 text-[0.95rem]"
        >
          {topics.map(({ slug, label }) => (
            <a
              href={getRelativeLocaleUrl(locale, `categories/${slug}`)}
              class="u-sweep"
              style={`color: ${categoryColor(slug)}`}
            >
              {label}
            </a>
          ))}
        </nav>
      )
    }

    {
      listPosts.length > 0 && (
        <section id="recent-posts" class="pt-6 pb-6">
          <h2 class="sr-only">{t.home.recentPosts}</h2>
          <ul class="sm:columns-2 sm:gap-14">
            {listPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
